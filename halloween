<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>萬聖節恐怖跑馬燈控制台 | Halloween Spooky Marquee</title>
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  
  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Creepster&family=Nosifer&family=Noto+Sans+TC:wght@500;700;900&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Custom font styles */
    .font-nosifer { font-family: 'Nosifer', cursive; }
    .font-creepster { font-family: 'Creepster', 'Noto Sans TC', cursive; }
    .font-noto { font-family: 'Noto Sans TC', sans-serif; }

    /* Custom Background */
    body {
      background-color: #08030c;
      background-image: 
        radial-gradient(circle at 50% 20%, #2a0845 0%, #0d0614 60%, #050208 100%);
    }

    /* Flickering Title Effect */
    @keyframes eerie-flicker {
      0%, 100% { opacity: 1; filter: drop-shadow(0 0 15px #ff3300); }
      33% { opacity: 0.85; filter: drop-shadow(0 0 5px #ff3300); }
      66% { opacity: 0.95; filter: drop-shadow(0 0 25px #ff6600); }
      77% { opacity: 0.6; filter: drop-shadow(0 0 2px #ff0000); }
    }
    .flicker-title {
      animation: eerie-flicker 4s infinite alternate;
    }

    /* Marquee animation wrapper & keyframes */
    .marquee-track {
      display: flex;
      width: max-content;
      will-change: transform;
    }

    @keyframes scroll-left {
      0% { transform: translateX(0%); }
      100% { transform: translateX(-50%); }
    }

    @keyframes scroll-right {
      0% { transform: translateX(-50%); }
      100% { transform: translateX(0%); }
    }

    .animate-scroll-left {
      animation: scroll-left var(--speed, 15s) linear infinite;
    }

    .animate-scroll-right {
      animation: scroll-right var(--speed, 15s) linear infinite;
    }

    /* Pause animation on container hover */
    .marquee-container:hover .marquee-track.pause-on-hover {
      animation-play-state: paused !important;
    }

    /* Manual Pause Class */
    .animation-paused {
      animation-play-state: paused !important;
    }

    /* Custom Scrollbar for Controls */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #140a24;
    }
    ::-webkit-scrollbar-thumb {
      background: #3b1566;
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #ff6600;
    }
  </style>
</head>
<body class="min-h-screen text-slate-100 font-noto flex flex-col justify-between p-4 md:p-8 selection:bg-orange-600 selection:text-white">

  <!-- Floating Decorative Spooky Elements -->
  <div class="fixed top-5 left-5 text-4xl opacity-40 hover:opacity-100 transition-opacity pointer-events-none select-none animate-bounce">🦇</div>
  <div class="fixed top-12 right-8 text-5xl opacity-30 hover:opacity-100 transition-opacity pointer-events-none select-none">🕷️</div>
  <div class="fixed bottom-6 left-8 text-4xl opacity-30 hover:opacity-100 transition-opacity pointer-events-none select-none">🔮</div>
  <div class="fixed bottom-8 right-6 text-5xl opacity-40 hover:opacity-100 transition-opacity pointer-events-none select-none animate-pulse">👻</div>

  <main class="max-w-5xl mx-auto w-full flex-grow flex flex-col justify-center items-center gap-8 py-6">
    
    <!-- Title Section -->
    <header class="text-center space-y-2">
      <h1 class="font-nosifer text-3xl sm:text-5xl md:text-6xl text-orange-500 tracking-wider flicker-title drop-shadow-[0_0_15px_rgba(255,102,0,0.8)]">
        🎃 HALLOWEEN MARQUEE 👻
      </h1>
      <p class="text-purple-300/80 text-sm md:text-base tracking-widest font-medium">
        萬聖節客製化恐怖跑馬燈產生器
      </p>
    </header>

    <!-- LIVE MARQUEE DISPLAY AREA -->
    <section class="w-full relative group">
      <!-- Glow Borders -->
      <div class="absolute -inset-1 bg-gradient-to-r from-orange-600 via-purple-600 to-green-500 rounded-2xl blur-md opacity-75 group-hover:opacity-100 transition duration-1000 group-hover:duration-200"></div>
      
      <!-- Main Container -->
      <div id="marqueeContainer" class="marquee-container relative w-full overflow-hidden bg-slate-950/90 border-2 border-orange-500/80 rounded-xl py-6 shadow-[inset_0_0_20px_rgba(147,51,234,0.3)]">
        
        <!-- Scrolling Content Track -->
        <div id="marqueeTrack" class="marquee-track animate-scroll-left pause-on-hover">
          <!-- Main Text Box 1 -->
          <div id="marqueeText1" class="marquee-item font-creepster whitespace-nowrap px-8 flex items-center transition-all duration-200">
            <!-- Text rendered via JS -->
          </div>
          <!-- Duplicate Text Box 2 (for seamless endless loop) -->
          <div id="marqueeText2" class="marquee-item font-creepster whitespace-nowrap px-8 flex items-center transition-all duration-200" aria-hidden="true">
            <!-- Text rendered via JS -->
          </div>
        </div>

        <!-- Hover Indicator Hint -->
        <div class="absolute right-3 bottom-2 text-[10px] text-purple-400/60 pointer-events-none uppercase tracking-wider hidden sm:block">
          [ 滑鼠移入可暫停滾動 Hover to Pause ]
        </div>
      </div>
    </section>

    <!-- INTERACTIVE CONTROL PANEL -->
    <section class="w-full bg-purple-950/40 backdrop-blur-md border border-purple-800/50 rounded-2xl p-5 md:p-8 shadow-2xl space-y-6">
      
      <div class="flex items-center justify-between border-b border-purple-800/60 pb-4">
        <h2 class="text-xl font-bold text-orange-400 flex items-center gap-2">
          <i data-lucide="sliders" class="w-5 h-5 text-orange-500"></i>
          跑馬燈控制台 (Control Panel)
        </h2>
        <button id="resetBtn" class="text-xs text-purple-300 hover:text-white bg-purple-900/60 hover:bg-purple-800 px-3 py-1.5 rounded-lg border border-purple-700/50 transition flex items-center gap-1">
          <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> 重設預設值
        </button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

        <!-- Left Column Controls: Text Input & Display Properties -->
        <div class="space-y-5">
          
          <!-- 1. Text Content Input -->
          <div class="space-y-2">
            <label for="textInput" class="text-sm font-medium text-purple-200 flex items-center gap-2">
              <i data-lucide="type" class="w-4 h-4 text-orange-400"></i> 跑馬燈文字 (Text Content)
            </label>
            <textarea id="textInput" rows="2" 
              class="w-full bg-slate-900/90 border border-purple-700/60 focus:border-orange-500 focus:ring-2 focus:ring-orange-500/40 rounded-xl p-3 text-orange-200 placeholder-purple-500/60 outline-none transition resize-none text-base font-medium"
              placeholder="輸入萬聖節祝福或標語..."></textarea>
          </div>

          <!-- Quick Emoji Presets -->
          <div class="flex flex-wrap gap-2 items-center">
            <span class="text-xs text-purple-400">快速加入符號:</span>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">🎃</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">👻</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">🦇</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">🕷️</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">🔮</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">💀</button>
            <button class="emoji-btn bg-slate-900 hover:bg-purple-900 text-base px-2 py-1 rounded border border-purple-800/60 transition">🍬</button>
          </div>

          <!-- 2. Font Size Control -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-sm text-purple-200">
              <label for="fontSize" class="flex items-center gap-2">
                <i data-lucide="scaling" class="w-4 h-4 text-orange-400"></i> 文字大小 (Font Size)
              </label>
              <span id="fontSizeVal" class="text-orange-400 font-mono font-bold bg-purple-950 px-2.5 py-0.5 rounded border border-purple-800">36px</span>
            </div>
            <input type="range" id="fontSize" min="18" max="80" value="36" 
              class="w-full accent-orange-500 bg-slate-900 h-2 rounded-lg cursor-pointer">
          </div>

          <!-- 3. Font Family Selector -->
          <div class="space-y-2">
            <label for="fontFamily" class="text-sm font-medium text-purple-200 flex items-center gap-2">
              <i data-lucide="font-family" class="w-4 h-4 text-orange-400"></i> 字型選擇 (Font Style)
            </label>
            <select id="fontFamily" class="w-full bg-slate-900/90 border border-purple-700/60 focus:border-orange-500 rounded-xl p-2.5 text-slate-200 outline-none">
              <option value="'Creepster', 'Noto Sans TC', cursive">Creepster (恐怖狂歡風格)</option>
              <option value="'Nosifer', cursive">Nosifer (滴血融化風格)</option>
              <option value="'Noto Sans TC', sans-serif">Noto Sans TC (標準微軟正黑體/無襯線)</option>
            </select>
          </div>

        </div>

        <!-- Right Column Controls: Colors, Glow & Speed Controls -->
        <div class="space-y-5">
          
          <!-- 4. Text Color & Spooky Presets -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-sm text-purple-200">
              <label class="flex items-center gap-2">
                <i data-lucide="palette" class="w-4 h-4 text-orange-400"></i> 文字顏色 (Text Color)
              </label>
              <input type="color" id="textColor" value="#ff7700" class="w-8 h-8 rounded-lg cursor-pointer bg-transparent border-0">
            </div>
            <!-- Preset Palette -->
            <div class="flex items-center gap-2 pt-1">
              <span class="text-xs text-purple-400">萬聖節主題色:</span>
              <button class="preset-color w-6 h-6 rounded-full bg-[#ff7700] ring-2 ring-transparent hover:scale-110 transition" data-color="#ff7700" title="南瓜橘"></button>
              <button class="preset-color w-6 h-6 rounded-full bg-[#00ff66] ring-2 ring-transparent hover:scale-110 transition" data-color="#00ff66" title="史萊姆綠"></button>
              <button class="preset-color w-6 h-6 rounded-full bg-[#bd00ff] ring-2 ring-transparent hover:scale-110 transition" data-color="#bd00ff" title="巫師紫"></button>
              <button class="preset-color w-6 h-6 rounded-full bg-[#ff0033] ring-2 ring-transparent hover:scale-110 transition" data-color="#ff0033" title="鮮血紅"></button>
              <button class="preset-color w-6 h-6 rounded-full bg-[#ffff00] ring-2 ring-transparent hover:scale-110 transition" data-color="#ffff00" title="月光黃"></button>
            </div>
          </div>

          <!-- 5. Glow Color & Glow Toggle -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-sm text-purple-200">
              <label class="flex items-center gap-2">
                <i data-lucide="sparkles" class="w-4 h-4 text-orange-400"></i> 螢光陰影 (Neon Glow)
              </label>
              <div class="flex items-center gap-3">
                <input type="color" id="glowColor" value="#ff3300" class="w-8 h-8 rounded-lg cursor-pointer bg-transparent border-0">
                <label class="inline-flex items-center cursor-pointer">
                  <input type="checkbox" id="glowToggle" checked class="sr-only peer">
                  <div class="w-9 h-5 bg-slate-900 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-4 after:w-4 after:transition-all peer-checked:bg-orange-600 relative"></div>
                </label>
              </div>
            </div>
          </div>

          <!-- 6. Speed Control Slider -->
          <div class="space-y-2">
            <div class="flex justify-between items-center text-sm text-purple-200">
              <label for="speedInput" class="flex items-center gap-2">
                <i data-lucide="gauge" class="w-4 h-4 text-orange-400"></i> 滾動速度 (Scroll Speed)
              </label>
              <span id="speedVal" class="text-orange-400 font-mono font-bold bg-purple-950 px-2.5 py-0.5 rounded border border-purple-800">15 秒/次</span>
            </div>
            <input type="range" id="speedInput" min="3" max="40" step="1" value="15" 
              class="w-full accent-orange-500 bg-slate-900 h-2 rounded-lg cursor-pointer">
            <div class="flex justify-between text-[11px] text-purple-400/80 px-1">
              <span>快速 (Fast)</span>
              <span>慢速 (Slow)</span>
            </div>
          </div>

          <!-- 7. Direction & Playback Buttons -->
          <div class="space-y-2 pt-1">
            <label class="text-sm font-medium text-purple-200 flex items-center gap-2">
              <i data-lucide="play-circle" class="w-4 h-4 text-orange-400"></i> 播放與方向控制 (Controls)
            </label>
            <div class="grid grid-cols-3 gap-2">
              <button id="togglePlayBtn" class="bg-orange-600 hover:bg-orange-500 text-white font-bold py-2 px-3 rounded-xl transition flex items-center justify-center gap-1.5 text-sm shadow-lg shadow-orange-900/40">
                <i data-lucide="pause" class="w-4 h-4"></i>
                <span id="playBtnText">暫停</span>
              </button>
              
              <button id="dirLeftBtn" class="bg-purple-900/80 hover:bg-purple-800 text-purple-200 font-medium py-2 px-3 rounded-xl border border-purple-700/60 transition flex items-center justify-center gap-1 text-sm border-orange-500 text-orange-300">
                <i data-lucide="arrow-left" class="w-4 h-4"></i> 向左滾動
              </button>

              <button id="dirRightBtn" class="bg-purple-900/80 hover:bg-purple-800 text-purple-200 font-medium py-2 px-3 rounded-xl border border-purple-700/60 transition flex items-center justify-center gap-1 text-sm">
                <i data-lucide="arrow-right" class="w-4 h-4"></i> 向右滾動
              </button>
            </div>
          </div>

        </div>
      </div>

    </section>

  </main>

  <!-- Footer -->
  <footer class="text-center text-xs text-purple-400/50 py-4">
    萬聖節風格跑馬燈控制台 &copy; 🎃 Spooky Halloween Interactive Web App
  </footer>

  <script>
    // Initialize Lucide Icons
    lucide.createIcons();

    // DOM Elements
    const marqueeTrack = document.getElementById('marqueeTrack');
    const marqueeText1 = document.getElementById('marqueeText1');
    const marqueeText2 = document.getElementById('marqueeText2');
    
    // Inputs
    const textInput = document.getElementById('textInput');
    const fontSizeInput = document.getElementById('fontSize');
    const fontSizeVal = document.getElementById('fontSizeVal');
    const fontFamilySelect = document.getElementById('fontFamily');
    const textColorInput = document.getElementById('textColor');
    const glowColorInput = document.getElementById('glowColor');
    const glowToggle = document.getElementById('glowToggle');
    const speedInput = document.getElementById('speedInput');
    const speedVal = document.getElementById('speedVal');
    
    // Buttons
    const togglePlayBtn = document.getElementById('togglePlayBtn');
    const playBtnText = document.getElementById('playBtnText');
    const dirLeftBtn = document.getElementById('dirLeftBtn');
    const dirRightBtn = document.getElementById('dirRightBtn');
    const resetBtn = document.getElementById('resetBtn');
    const emojiBtns = document.querySelectorAll('.emoji-btn');
    const presetColorBtns = document.querySelectorAll('.preset-color');

    // Default State
    const defaultState = {
      text: '🎃 不給糖就搗蛋！ TRICK OR TREAT! 👻 小心鬼怪出沒！ 🦇 歡迎來到萬聖節狂歡夜 🔮',
      fontSize: 36,
      fontFamily: "'Creepster', 'Noto Sans TC', cursive",
      textColor: '#ff7700',
      glowColor: '#ff3300',
      glowEnabled: true,
      speed: 15,
      direction: 'left', // 'left' or 'right'
      isPlaying: true
    };

    let state = { ...defaultState };

    // Update Functions
    function updateTextContent() {
      const content = state.text.trim() || '🎃 HAPPY HALLOWEEN 👻';
      marqueeText1.textContent = content;
      marqueeText2.textContent = content;
    }

    function updateStyles() {
      // Font Size
      const sizePx = `${state.fontSize}px`;
      marqueeText1.style.fontSize = sizePx;
      marqueeText2.style.fontSize = sizePx;
      fontSizeVal.textContent = sizePx;

      // Font Family
      marqueeText1.style.fontFamily = state.fontFamily;
      marqueeText2.style.fontFamily = state.fontFamily;

      // Color & Glow Shadow
      marqueeText1.style.color = state.textColor;
      marqueeText2.style.color = state.textColor;

      if (state.glowEnabled) {
        const glow = `0 0 8px ${state.glowColor}, 0 0 18px ${state.glowColor}, 0 0 30px rgba(153,0,255,0.5)`;
        marqueeText1.style.textShadow = glow;
        marqueeText2.style.textShadow = glow;
      } else {
        marqueeText1.style.textShadow = 'none';
        marqueeText2.style.textShadow = 'none';
      }

      // Speed
      marqueeTrack.style.setProperty('--speed', `${state.speed}s`);
      speedVal.textContent = `${state.speed} 秒/次`;
    }

    function updateAnimationState() {
      // Play/Pause
      if (state.isPlaying) {
        marqueeTrack.classList.remove('animation-paused');
        togglePlayBtn.classList.replace('bg-green-600', 'bg-orange-600');
        togglePlayBtn.classList.replace('hover:bg-green-500', 'hover:bg-orange-500');
        playBtnText.textContent = '暫停';
        togglePlayBtn.querySelector('i').setAttribute('data-lucide', 'pause');
      } else {
        marqueeTrack.classList.add('animation-paused');
        togglePlayBtn.classList.replace('bg-orange-600', 'bg-green-600');
        togglePlayBtn.classList.replace('hover:bg-orange-500', 'hover:bg-green-500');
        playBtnText.textContent = '播放';
        togglePlayBtn.querySelector('i').setAttribute('data-lucide', 'play');
      }

      // Direction
      if (state.direction === 'left') {
        marqueeTrack.classList.remove('animate-scroll-right');
        marqueeTrack.classList.add('animate-scroll-left');
        dirLeftBtn.classList.add('border-orange-500', 'text-orange-300');
        dirRightBtn.classList.remove('border-orange-500', 'text-orange-300');
      } else {
        marqueeTrack.classList.remove('animate-scroll-left');
        marqueeTrack.classList.add('animate-scroll-right');
        dirRightBtn.classList.add('border-orange-500', 'text-orange-300');
        dirLeftBtn.classList.remove('border-orange-500', 'text-orange-300');
      }

      lucide.createIcons();
    }

    // Event Listeners
    textInput.addEventListener('input', (e) => {
      state.text = e.target.value;
      updateTextContent();
    });

    fontSizeInput.addEventListener('input', (e) => {
      state.fontSize = e.target.value;
      updateStyles();
    });

    fontFamilySelect.addEventListener('change', (e) => {
      state.fontFamily = e.target.value;
      updateStyles();
    });

    textColorInput.addEventListener('input', (e) => {
      state.textColor = e.target.value;
      updateStyles();
    });

    glowColorInput.addEventListener('input', (e) => {
      state.glowColor = e.target.value;
      updateStyles();
    });

    glowToggle.addEventListener('change', (e) => {
      state.glowEnabled = e.target.checked;
      updateStyles();
    });

    speedInput.addEventListener('input', (e) => {
      state.speed = e.target.value;
      updateStyles();
    });

    // Preset Color Buttons
    presetColorBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const color = btn.getAttribute('data-color');
        state.textColor = color;
        textColorInput.value = color;
        updateStyles();
      });
    });

    // Quick Emoji Insert Buttons
    emojiBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const emoji = btn.textContent;
        textInput.value += ` ${emoji} `;
        state.text = textInput.value;
        updateTextContent();
      });
    });

    // Playback Toggle
    togglePlayBtn.addEventListener('click', () => {
      state.isPlaying = !state.isPlaying;
      updateAnimationState();
    });

    // Direction Controls
    dirLeftBtn.addEventListener('click', () => {
      state.direction = 'left';
      updateAnimationState();
    });

    dirRightBtn.addEventListener('click', () => {
      state.direction = 'right';
      updateAnimationState();
    });

    // Reset Button
    resetBtn.addEventListener('click', () => {
      state = { ...defaultState };
      textInput.value = state.text;
      fontSizeInput.value = state.fontSize;
      fontFamilySelect.value = state.fontFamily;
      textColorInput.value = state.textColor;
      glowColorInput.value = state.glowColor;
      glowToggle.checked = state.glowEnabled;
      speedInput.value = state.speed;

      updateTextContent();
      updateStyles();
      updateAnimationState();
    });

    // Init App
    function init() {
      textInput.value = state.text;
      updateTextContent();
      updateStyles();
      updateAnimationState();
    }

    window.onload = init;
  </script>
</body>
</html>
